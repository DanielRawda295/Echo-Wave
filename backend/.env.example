# Local development database. Create this database before starting NestJS.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace_with_your_local_database_password
DB_NAME=echowave

# Replace with a long, randomly generated private signing secret.
JWT_SECRET=replace_with_a_long_random_private_secret
JWT_EXPIRES_IN=1d

# Optional Google sign-in; both values are required by the current backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional reset-email delivery (STARTTLS-style SMTP; secure=false in the current code).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
