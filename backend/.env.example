# Local development database. Create this database before starting NestJS.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace_with_your_local_database_password
DB_NAME=echowave

# Supabase / hosted PostgreSQL. Takes precedence over local DB_* connection fields.
# If the URL contains [YOUR-PASSWORD], DB_PASS supplies that password safely.
DATABASE_URL=
# Hosted connections use a separate schema, outside Supabase's public Data API.
# Leave blank to use echowave remotely and public for local development.
DB_SCHEMA=
# Optional provider root CA, if the certificate isn't publicly trusted.
DB_SSL_CA_FILE=
DB_SSL_CA=
# Local development only. Hosted connections always disable automatic sync.
DB_SYNCHRONIZE=true

# Replace with a long, randomly generated private signing secret.
JWT_SECRET=replace_with_a_long_random_private_secret
JWT_EXPIRES_IN=1d

# Exact browser origins allowed to call the API; comma-separate multiple origins.
FRONTEND_ORIGIN=http://localhost:5173
# PORT is normally supplied by the hosting provider; local default is 3000.
PORT=3000

# Hosted media storage. Backend only; never copy the secret into frontend settings.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=echowave-media

# Optional Google sign-in. ID-token verification needs only the public client ID.
GOOGLE_CLIENT_ID=
# Optional, reserved for a future authorization-code flow:
GOOGLE_CLIENT_SECRET=

# Password-reset email via Brevo HTTP API (works on Render Free).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=EchoWave

# Optional SMTP fallback for local development only.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
